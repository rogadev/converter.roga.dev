{
  "name": "converter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test:unit": "vitest --project server",
    "test:ui": "vitest --project client",
    "test": "pnpm run -s test:unit -- --run && pnpm run -s test:ui -- --run && pnpm run -s test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.11",
    "@ffmpeg/util": "^0.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@sveltejs/adapter-auto": "^6.1.0",
    "@sveltejs/adapter-vercel": "^5.6.3",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.2.0",
    "@vitest/browser": "^3.2.3",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "playwright": "^1.53.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.3",
    "vitest-browser-svelte": "^0.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ],
    "overrides": {
      "cookie@<0.7.0": ">=0.7.0",
      "devalue@<5.3.2": ">=5.3.2",
      "vite@>=7.1.0 <=7.1.4": ">=7.1.5",
      "vite@>=7.1.0 <=7.1.10": ">=7.1.11",
      "playwright@<1.55.1": ">=1.55.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "devalue@>=5.1.0 <5.6.2": ">=5.6.2",
      "@sveltejs/kit@>=2.19.0 <=2.49.4": ">=2.49.5",
      "tar@<7.5.7": ">=7.5.7",
      "tar@<=7.5.2": ">=7.5.3",
      "devalue@<=5.6.2": ">=5.6.3",
      "tar@<7.5.8": ">=7.5.8",
      "svelte@<=5.51.4": ">=5.51.5",
      "@sveltejs/adapter-vercel@<6.3.2": ">=6.3.2",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "tar@<=7.5.9": ">=7.5.10",
      "tar@<=7.5.10": ">=7.5.11",
      "svelte@<=5.53.4": ">=5.53.5",
      "devalue@<5.6.4": ">=5.6.4",
      "devalue@<=5.6.3": ">=5.6.4",
      "tar@<=7.5.3": ">=7.5.4",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4"
    }
  }
}
